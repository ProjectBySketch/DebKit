# DebKit: the .deb runtime.
#
# init creates the tree under /data before any service starts, then starts the
# daemon once the system has booted. The daemon is the only thing that touches
# /data/debkit, and everything it runs runs inside the Debian chroot.

on post-fs-data
    mkdir /data/debkit 0771 root system
    mkdir /data/debkit/rootfs 0771 root system
    mkdir /data/debkit/db 0771 root system
    mkdir /data/debkit/cache 0771 root system
    mkdir /data/debkit/run 0700 root root
    mkdir /data/debkit/log 0771 root system
    chmod 0700 /data/debkit/run
    chown root root /data/debkit/run

service debkitd /system_ext/bin/debkitd serve
    class late_start
    user root
    group root system
    seclabel u:r:debkitd:s0
    disabled

# Started once boot is complete: first boot is the slow one, and nothing needs
# the daemon until someone installs a .deb. `setprop ro.debkit.autostart 0`
# before boot keeps it off, in which case `deb` does its work in-process.
on property:sys.boot_completed=1 && property:ro.debkit.autostart=1
    start debkitd

on property:ro.debkit.autostart=0
    stop debkitd
