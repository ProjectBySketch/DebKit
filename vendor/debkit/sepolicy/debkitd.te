# DebKit domain.
#
# debkitd installs packages and then executes arbitrary binaries from them
# inside a chroot, which is the whole point of the image - so this domain is
# permissive while the policy is being written. It is a bring-up policy: it
# keeps user builds booting and logcat quiet-ish, but it does not confine
# anything yet. Move it to system_ext private policy and drop `permissive`
# once the allow rules below cover a real session without denials.

type debkitd, domain;
type debkitd_exec, exec_type, file_type, system_file_type;

init_daemon_domain(debkitd)

# A chroot needs these, and the packages it runs need the rest.
allow debkitd self:capability {
    chown
    dac_override
    dac_read_search
    fowner
    fsetid
    kill
    mknod
    net_admin
    net_raw
    setgid
    setuid
    sys_admin
    sys_chroot
};
allow debkitd self:process { fork transition setcurrent setsched sigchld };
allow debkitd self:unix_stream_socket { create bind listen accept connect read write getattr getopt setopt shutdown };
allow debkitd debkitd_exec:file { read open getattr map execute execute_no_trans entrypoint };

# /data/debkit: the rootfs, the package database and the socket.
allow debkitd system_data_file:dir { create read write open getattr setattr search add_name remove_name rename rmdir };
allow debkitd system_data_file:file { create read write open getattr setattr unlink rename append map execute execute_no_trans };
allow debkitd system_data_file:sock_file { create read write open getattr setattr unlink };

# Mounts for the chroot and the device nodes bound into it.
allow debkitd fs_type:filesystem { mount remount unmount };
allow debkitd tmpfs:dir { create read write open getattr setattr search add_name remove_name rmdir };
allow debkitd tmpfs:file { create read write open getattr setattr unlink };
allow debkitd devpts:chr_file { read write open getattr ioctl };
allow debkitd device:dir { read open getattr search };
allow debkitd dev_type:chr_file { read write open getattr ioctl };
allow debkitd proc:dir { read open getattr search };
allow debkitd proc:file { read open getattr write };
allow debkitd proc_net:file { read open getattr };
allow debkitd proc_sys_fs:dir { read open getattr search };

# binfmt_misc, which is what makes the other architecture work.
allow debkitd binfmt_misc_fs:dir { read write open getattr search add_name };
allow debkitd binfmt_misc_fs:file { create read write open getattr unlink };

permissive debkitd;
